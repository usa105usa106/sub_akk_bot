TELEGRAM_BOT_TOKEN=
BOT_VERSION=0224
DEFAULT_EXCHANGE=mexc
DEFAULT_AI_PROVIDER=openai
DEFAULT_OPENAI_MODEL=gpt-5.4-mini
# 0 = /testai uses only the key saved by /setopenai. Set 1 to allow Railway OPENAI_API_KEY fallback.
OPENAI_ENV_FALLBACK=0
OLLAMA_MODELS=llama3.1:8b,deepseek-r1:8b
DEFAULT_MODEL=llama3.1:8b
DEFAULT_RISK_PERCENT=1
# Slot model: 10 slots. One new trade uses 10% of current free balance as margin.
DEFAULT_MAX_TRADES=10
MIN_SINGLE_TRADE_MARGIN_PERCENT=10
TARGET_SINGLE_TRADE_MARGIN_PERCENT=10
MAX_SINGLE_TRADE_MARGIN_PERCENT=10
AI_PROMPT_DETAIL=balanced
DEFAULT_LEVERAGE=5
DEFAULT_MIN_SCORE=80

# Startup defaults: AUTO trading profile for Trendline + RS/BTC + Super Volume.
DEFAULT_TRADING_MODE=auto
DEFAULT_TRADING_ENABLED=on
DEFAULT_AI_AUTO=on
DEFAULT_REAL_EXECUTION_ENABLED=on
DEFAULT_PARTIAL_TP_ENABLED=on
DEFAULT_PARTIAL_TP_R=2
DEFAULT_PARTIAL_TP_PERCENT=50
DEFAULT_BREAKEVEN_ENABLED=on
DEFAULT_BREAKEVEN_R=2
DEFAULT_TRAILING_ENABLED=on
DEFAULT_TRAILING_R=3
DEFAULT_SCANNER_SIZE=200
DEFAULT_TOP_LIMIT=5
DEFAULT_AUTO_SCANNER_INTERVAL=off
DEFAULT_STRUCTURAL_MODE=trendline_rs_volume
DEFAULT_EXTENDED_TP_ENABLED=on
DEFAULT_EXTENDED_TP_MIN_CONFIDENCE=80
DEFAULT_EXTENDED_TP_RR=4
DEFAULT_STOP_ALL_ENABLED=off
DEFAULT_POSITION_SYNC_ENABLED=on
DEFAULT_POSITION_SYNC_INTERVAL=300
DEFAULT_STRICT_AI_MODE=on

DEFAULT_LIVE_TRADE_MANAGER_ENABLED=on
# Live TM optional actions (BE/partial/trailing/runner close) wait this long after entry. Exchange SL/TP still works immediately.
DEFAULT_LIVE_TM_MIN_HOLD_SECONDS=0
DEFAULT_LIVE_TM_TRAILING_MIN_PROFIT_PCT=3.0
DEFAULT_LIVE_TM_VERIFY_PROTECTION=on

OLLAMA_KEEP_ALIVE=10m

AI_MAX_CONCURRENT=1
AI_APPROVAL_TOP_LIMIT=5
AI_CHAT_NUM_PREDICT=128
AI_APPROVAL_NUM_PREDICT=120

# MEXC support recommendation: max 4 requests within 2 seconds.
SCAN_MAX_CONCURRENT=5
SCAN_REQUEST_PAUSE=0.55

# Hard timeout for one coin scan, prevents full scan/autopilot from hanging on one bad MEXC/CCXT request.
SCAN_SYMBOL_TIMEOUT=12

# Memory optimization
MAX_OHLCV_LIMIT=160
SCAN_GC_EVERY=25
MAX_LIQUIDITY_CACHE=300
MAX_INSTITUTIONAL_CACHE=300

# Market metadata loaded once and reused; prevents repeated load_markets memory/API churn.
MARKETS_CACHE_TTL=21600
MAX_LAST_SCAN_RESULTS=25
MAX_AI_CONFIRMED_RESULTS=25
# Fast menu ping timeout only (does not affect trading scan timeout)
EXCHANGE_PING_TIMEOUT_SEC=2.0
EXCHANGE_PING_TIMEOUT_MS=2000

# CCXT network timeout for exchange calls. Keeps hung requests from blocking scanner threads too long.
EXCHANGE_TIMEOUT_MS=8000
# MEXC native TP/SL trigger safety buffer (prevents code 2015/5003)
MEXC_TRIGGER_MIN_BUFFER_PCT=0.0015
MEXC_MAX_TRIGGER_ADJUST_PCT=0.006

# v0135 hide closed/stale local positions from /positions
DEFAULT_MOMENTUM_SL_ATR_MULT=2.4
DEFAULT_MOMENTUM_MIN_SL_PCT=2.0
DEFAULT_MOMENTUM_MAX_SL_PCT=6.0

DEFAULT_COOLDOWN_MINUTES=30
DEFAULT_ANTI_CHURN_COOLDOWN_MINUTES=30
DEFAULT_LIVE_TM_TRAILING_MIN_PROFIT_PCT=3.0
DEFAULT_PARTIAL_TP_ENABLED=on
DEFAULT_PARTIAL_TP_R=2.0
DEFAULT_PARTIAL_TP_PERCENT=50
DEFAULT_BREAKEVEN_ENABLED=on
DEFAULT_BREAKEVEN_R=2.0
DEFAULT_TRAILING_ENABLED=on
DEFAULT_TRAILING_R=3.0

# v0147 OpenAI guard: Chat Completions only, no Responses fallback.
OPENAI_CHAT_RETRY_COUNT=1
OPENAI_MAX_PROMPT_CHARS=12000
AI_APPROVAL_NUM_PREDICT=120
AI_CHAT_NUM_PREDICT=120

# v0147 BTC/ETH Soft mode defaults
DEFAULT_BTCETH_SOFT_RR=1.15
DEFAULT_BTCETH_SOFT_SL_ATR_MULT=1.2
DEFAULT_BTCETH_SOFT_MIN_SL_PCT=0.45
DEFAULT_BTCETH_SOFT_MAX_SL_PCT=1.20

# BTC/ETH Soft high-winrate filter defaults
DEFAULT_BTCETH_SOFT_MAX_SPREAD_PCT=0.08
DEFAULT_BTCETH_SOFT_MIN_RVOL=1.05
DEFAULT_BTCETH_SOFT_MIN_ATR_PCT=0.10
DEFAULT_BTCETH_SOFT_MAX_ATR_PCT=2.20
DEFAULT_BTCETH_SOFT_LATE_MOVE_PCT_BTC=1.20
DEFAULT_BTCETH_SOFT_LATE_MOVE_PCT_ETH=1.60

# v0179: by default bot does not skip valid ~9-10 USDT slot positions by synthetic usable-notional guard.
ENFORCE_MIN_USABLE_NOTIONAL=false

# SR Rebound Auto Mode defaults
DEFAULT_SR_REBOUND_MIN_TOUCHES=1
DEFAULT_SR_REBOUND_MAX_PRIOR_TOUCHES=2
DEFAULT_SR_REBOUND_TOUCH_ATR_MULT=0.85
DEFAULT_SR_REBOUND_ZONE_PCT=0.007
DEFAULT_SR_REBOUND_RR=1.4
